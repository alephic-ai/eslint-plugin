{
  "name": "@alephic-ai/eslint-plugin",
  "version": "0.1.0",
  "description": "Alephic's custom ESLint rules",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alephic-ai/eslint-plugin.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --fix . && prettier --write --log-level=error . && tsc6",
    "test": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.65.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/rule-tester": "8.65.0",
    "eslint": "10.7.0",
    "eslint-doc-generator": "3.7.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-plugin": "7.5.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-perfectionist": "5.10.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sort-json": "4.2.0",
    "tsdown": "0.22.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
